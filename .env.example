# Taranis Dataroom — local development environment.
#
# Copy to .env and fill in. Names and placeholders only: never commit a real
# secret value to this repository. Production secrets live in AWS Secrets
# Manager and production configuration lives on the ECS task definition.

# PostgreSQL
POSTGRES_USER=taranis
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=dataroom
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API
API_PORT=4000
NODE_ENV=development

# Web (Vite). Leave unset to use the relative /api path, which is what the
# production build uses.
VITE_API_URL=http://localhost:4000

# JWT signing secret. Local placeholder only — production reads
# taranis-dataroom/jwt/signing from Secrets Manager.
JWT_SECRET=local-dev-secret-do-not-use-in-production

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
# In production, S3_BUCKET and AWS_REGION are set on the ECS task definition
# (family taranis-dataroom) and are NOT read from this file:
#
#   S3_BUCKET=taranis-dataroom-documents-prod
#   AWS_REGION=eu-west-2
#
# Credentials come from the container credential chain via the task role
# taranis-dataroom-task-role. Never put an AWS access key here.
#
# Leave S3_BUCKET empty for local development and the API stores documents on
# local disk instead (packages/api/uploads, or LOCAL_STORAGE_DIR). That is not
# durable and is for development only.
S3_BUCKET=
AWS_REGION=eu-west-2
# LOCAL_STORAGE_DIR=
