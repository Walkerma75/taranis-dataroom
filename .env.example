# Taranis Dataroom — local development environment.
#
# Copy to .env and fill in. Names and placeholders only: never commit a real
# secret value to this repository. Production secrets live in AWS Secrets
# Manager and production configuration lives on the ECS task definition.

# PostgreSQL
POSTGRES_USER=taranis
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=dataroom
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API
API_PORT=4000
NODE_ENV=development

# Web (Vite). Leave unset to use the relative /api path, which is what the
# production build uses.
VITE_API_URL=http://localhost:4000

# JWT signing secret. Local placeholder only — production reads
# taranis-dataroom/jwt/signing from Secrets Manager.
JWT_SECRET=local-dev-secret-do-not-use-in-production

# ---------------------------------------------------------------------------
# Document storage
# ---------------------------------------------------------------------------
# In production, S3_BUCKET and AWS_REGION are set on the ECS task definition
# (family taranis-dataroom) and are NOT read from this file:
#
#   S3_BUCKET=taranis-dataroom-documents-prod
#   AWS_REGION=eu-west-2
#
# Credentials come from the container credential chain via the task role
# taranis-dataroom-task-role. Never put an AWS access key here.
#
# Leave S3_BUCKET empty for local development and the API stores documents on
# local disk instead (packages/api/uploads, or LOCAL_STORAGE_DIR). That is not
# durable and is for development only.
S3_BUCKET=
AWS_REGION=eu-west-2
# LOCAL_STORAGE_DIR=

# ---------------------------------------------------------------------------
# Outstanding due diligence actions (dashboard, nav badge, daily digest)
# ---------------------------------------------------------------------------
# Ageing thresholds for the dashboard's Due diligence panel. Taranis-side is
# counted in WORKING days (Mon-Fri), company-side in CALENDAR days. The values
# below are the defaults and are what the code uses when these are unset, so
# they only need setting to change them.
#
#   DD_AGE_TARANIS_AMBER_DAYS=1
#   DD_AGE_TARANIS_RED_DAYS=3
#   DD_AGE_COMPANY_AMBER_DAYS=3
#   DD_AGE_COMPANY_RED_DAYS=7
#
# The daily digest to ADMIN_NOTIFICATION_EMAIL. OFF unless this is exactly
# 'true', and it stays off until Mark has approved the wording: the template is
# a draft and the flag is what keeps a draft out of an inbox. Once approved,
# set it on the ECS task definition.
#
#   DD_DIGEST_ENABLED=true
#
# When to send, in local time at a fixed UTC offset. The defaults are 07:00 at
# UTC+4 (Dubai, which observes no daylight saving), Monday to Friday, sent only
# if something is outstanding. The window is how long after the hour a task that
# was restarting may still send it.
#
#   DD_DIGEST_HOUR_LOCAL=7
#   DD_DIGEST_UTC_OFFSET_HOURS=4
#   DD_DIGEST_WINDOW_HOURS=2
